<Window x:Class="CClean.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CClean"
        xmlns:ctl="clr-namespace:CClean.Controls"
        mc:Ignorable="d"
        Title="C 盘清理工具" Height="640" Width="900"
        MinHeight="560" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="#14161F"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 青蓝渐变（主色），按钮和仪表盘共用 -->
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2EE6C0" Offset="0"/>
            <GradientStop Color="#17B6E6" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="CardBrush" Color="#1E2230"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#262B3B"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#2A3040"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#EAECF2"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#828B9F"/>

        <!-- 渐变主按钮 -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="#0B1118"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource AccentGradient}"
                                CornerRadius="10" Padding="26,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 描边次按钮（深色） -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#222736" CornerRadius="10"
                                BorderBrush="#333A4D" BorderThickness="1" Padding="20,11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2B3142"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片上的小按钮（打开目录） -->
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A9B2C4"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#232A3A" CornerRadius="8"
                                BorderBrush="#333A4D" BorderThickness="1" Padding="12,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2D3548"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3A7A8C"/>
                                <Setter Property="Foreground" Value="#2EE6C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧边栏导航项 -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="12,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="10" Padding="14,11" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="16" Margin="0,0,12,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1B2030"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1B2737"/>
                                <Setter Property="Foreground" Value="#2EE6C0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>   <!-- 侧边栏 -->
            <ColumnDefinition Width="*"/>     <!-- 主内容 -->
        </Grid.ColumnDefinitions>

        <!-- ===================== 侧边栏 ===================== -->
        <Border Grid.Column="0" Background="#0F111A">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="22,26,0,28">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentGradient}">
                        <TextBlock Text="🧹" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="C-Clean" Foreground="{StaticResource TextPrimary}" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="磁盘清理" Foreground="{StaticResource TextSecondary}" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>

                <!-- 导航：切换两个页面 -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavAnalysis" Style="{StaticResource NavItem}" Tag="📊"
                                 Content="空间分析" IsChecked="True" Checked="NavAnalysis_Checked"/>
                    <RadioButton x:Name="NavCleanup" Style="{StaticResource NavItem}" Tag="🧹"
                                 Content="可清理项" Checked="NavCleanup_Checked"/>
                </StackPanel>

                <!-- 底部小标 -->
                <TextBlock Grid.Row="2" Text="v0.3 · 空间分析 + 清理" Foreground="#4A5267" FontSize="11"
                           Margin="22,0,0,18"/>
            </Grid>
        </Border>

        <!-- ===================== 主内容 ===================== -->
        <Grid Grid.Column="1" Margin="28,26,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 仪表盘头部（两页共用） -->
                <RowDefinition Height="*"/>     <!-- 可切换内容区 -->
            </Grid.RowDefinitions>

            <!-- ===== 头部：环形仪表盘 + 概要 ===== -->
            <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="28,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 环形仪表盘 -->
                    <Grid Grid.Column="0" Width="150" Height="150">
                        <Ellipse Width="132" Height="132" Stroke="{StaticResource TrackBrush}" StrokeThickness="13"/>
                        <Path x:Name="GaugeArc" Stroke="{StaticResource AccentGradient}" StrokeThickness="13"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="GaugePercent" Text="--" Foreground="{StaticResource TextPrimary}"
                                       FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="已使用" Foreground="{StaticResource TextSecondary}"
                                       FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- 概要文字 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="26,0,0,0">
                        <TextBlock x:Name="DriveTitle" Text="本地磁盘 (C:)" Foreground="{StaticResource TextPrimary}"
                                   FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="DriveUsageText" Text="正在读取磁盘信息…" Foreground="{StaticResource TextSecondary}"
                                   FontSize="13.5" Margin="0,6,0,0"/>
                        <Button x:Name="ScanButton" Content="🔍  重新扫描" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left" Margin="0,16,0,0" Click="ScanButton_Click"/>
                    </StackPanel>

                    <!-- 已选大小 -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="已选可清理" Foreground="{StaticResource TextSecondary}" FontSize="12.5"
                                   HorizontalAlignment="Right"/>
                        <TextBlock x:Name="SelectedSizeText" Text="0 B" FontSize="30" FontWeight="Bold"
                                   Foreground="#2EE6C0" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 可切换内容区：空间分析 / 可清理项 ===== -->
            <Grid Grid.Row="1" Margin="0,18,0,0">

                <!-- ===== 页面 1：空间分析（treemap） ===== -->
                <Grid x:Name="AnalysisPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- 工具条：返回 + 当前路径 + 悬停信息 -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BackButton" Content="⬆ 返回上级" Style="{StaticResource MiniButton}"
                                    Click="BackButton_Click" IsEnabled="False"/>
                            <TextBlock x:Name="BreadcrumbText" Text="C:\" Foreground="{StaticResource TextPrimary}"
                                       FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            <ProgressBar x:Name="AnalysisProgress" IsIndeterminate="True" Width="80" Height="5"
                                         Foreground="#2EE6C0" Background="#262B3B" BorderThickness="0"
                                         Visibility="Collapsed" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="HoverText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}" FontSize="12.5"/>
                    </Grid>
                    <Border Grid.Row="1" CornerRadius="14" ClipToBounds="True" Background="#1A1D29">
                        <ctl:TreemapControl x:Name="Treemap"/>
                    </Border>
                </Grid>

                <!-- ===== 页面 2：可清理项 ===== -->
                <Grid x:Name="CleanupPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListView x:Name="CategoryList" Grid.Row="0"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionMode="Single"
                              MouseDoubleClick="CategoryList_MouseDoubleClick">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="bd" Background="{StaticResource CardBrush}" CornerRadius="14"
                                            BorderBrush="#262C3C" BorderThickness="1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#34607A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="18,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <!-- 图标圆底 -->
                            <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12" Background="#252B3B"
                                    Margin="0,0,16,0">
                                <TextBlock Text="{Binding Icon}" FontSize="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}"
                                               FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <!-- 安全等级小药丸 -->
                                    <Border Background="{Binding SafetyBackground}" CornerRadius="6"
                                            Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SafetyBadge}" Foreground="{Binding SafetyForeground}"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondary}"
                                           FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <!-- 补充信息（如软件安装日期），无内容时隐藏 -->
                                <TextBlock Text="{Binding Note}" Foreground="#5E667A" FontSize="11.5" Margin="0,3,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasNote}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" Foreground="{StaticResource TextPrimary}"
                                       FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="18,0,2,0"/>

                            <!-- 打开目录，让用户自己手动删除 -->
                            <Button Grid.Column="4" Content="📂 打开" Style="{StaticResource MiniButton}"
                                    VerticalAlignment="Center" Margin="16,0,0,0"
                                    ToolTip="在资源管理器中打开该目录，自行查看和删除"
                                    Click="OpenFolder_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <!-- 按安全等级分组的标题样式 -->
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,14,0,8">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold"
                                               Foreground="#C2CAD9"/>
                                    <TextBlock Text="{Binding ItemCount, StringFormat='（{0} 项）'}"
                                               FontSize="13" Foreground="#5E667A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
            </ListView>

                    <!-- 清理操作条 -->
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Width="90" Height="5"
                                         Foreground="#2EE6C0" Background="#262B3B" BorderThickness="0"
                                         Visibility="Collapsed" Margin="0,0,12,0"/>
                            <TextBlock x:Name="StatusText" Text="准备扫描…"
                                       Foreground="{StaticResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox x:Name="RecycleCheck" Content="删除到回收站（可恢复）" IsChecked="True"
                                      Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                      Margin="0,0,16,0"/>
                            <Button x:Name="CleanButton" Content="🧹  立即清理" Style="{StaticResource AccentButton}"
                                    Click="CleanButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
